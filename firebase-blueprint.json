{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account for applicants and recruiters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["applicant", "admin", "recruiter"] },
        "companyId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Company": {
      "title": "Company",
      "description": "Hiring organization tenant profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "logo": { "type": "string" },
        "industry": { "type": "string" },
        "location": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "Job": {
      "title": "Job",
      "description": "Job opening created by a company tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "department": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed", "draft"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyId", "title"]
    },
    "Application": {
      "title": "Application",
      "description": "Candidate application to a job",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "applicantId": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantEmail": { "type": "string", "format": "email" },
        "companyId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "accepted", "rejected"] },
        "appliedAt": { "type": "string" }
      },
      "required": ["id", "jobId", "applicantId", "applicantEmail", "companyId"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and compliance audit event trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "actorId": { "type": "string" },
        "actorEmail": { "type": "string" },
        "action": { "type": "string" },
        "tenantId": { "type": "string" }
      },
      "required": ["id", "timestamp", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Company tenant organizations"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job listings"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Candidate job applications"
    },
    "/auditLogs/{auditId}": {
      "schema": "AuditLog",
      "description": "Enterprise compliance audit logs"
    }
  }
}
